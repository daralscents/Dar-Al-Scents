{
  "name": "dar-al-scents-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Intern bedrijfsdashboard voor Dar Al Scents: producten, leveranciers, inkoop, voorraad, verkopen en financiën.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings --watch src/server.js",
    "migrate": "node --no-warnings scripts/migrate.js",
    "create-user": "node --no-warnings scripts/create-user.js",
    "seed:demo": "node --no-warnings scripts/seed-demo.js",
    "backup": "node --no-warnings scripts/backup.js",
    "restore": "node --no-warnings scripts/restore.js",
    "test": "node --no-warnings --test test/*.test.js",
    "test:browser": "node --no-warnings scripts/browser-test.js",
    "demo": "node --no-warnings scripts/demo.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2"
  }
}
