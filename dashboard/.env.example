# Kopieer naar .env en pas aan. Zet hier GEEN wachtwoorden of echte geheimen in versiebeheer.
PORT=3000
# Alleen lokaal bereikbaar. Zet op 0.0.0.0 achter een reverse proxy met HTTPS.
HOST=127.0.0.1
# Map voor database en bijlagen (wordt aangemaakt).
DATA_DIR=data
DB_FILE=dar-al-scents.sqlite
BACKUP_DIR=backups
# true zodra de app via HTTPS draait (cookie alleen over HTTPS).
COOKIE_SECURE=false
# Bijv. 1 als de app achter één reverse proxy draait.
TRUST_PROXY=
# Optioneel: eenmalige code om via /installeren de eerste beheerder in de browser aan te maken.
# Leeg laten = alleen via `npm run create-user`.
SETUP_TOKEN=
