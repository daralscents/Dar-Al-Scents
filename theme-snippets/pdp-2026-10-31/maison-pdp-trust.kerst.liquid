<div class="m-pdp-trust">
  {% render 'maison-pdp-buybox' %}
  {%- comment -%}
    Productpagina (22 okt 2026, rustig): groen kerstblok met één zin over de besteldeadline (verdwijnt na kerst),
    samplepakket als kaart, 3 pictogrammen, verzendregel, WhatsApp. Opmaak in maison-pdp-style.
  {%- endcomment -%}
  {%- liquid
    assign das_has_sample = false
    assign das_bottle = false
    for v in product.variants
      assign vt = v.title | downcase
      if vt contains 'sample' or vt == '3ml' or vt == '3 ml'
        if v.available
          assign das_has_sample = true
        endif
      else
        assign das_bottle = true
      endif
    endfor
  -%}
  {%- liquid
    assign xp_tip = false
    for col in product.collections
      if col.handle == 'giftset' or col.handle == 'cadeaus-onder-30'
        assign xp_tip = true
      endif
    endfor
  -%}
  {%- capture xp_dl -%}{% render 'maison-x-t', k: 'deadline' %}{%- endcapture -%}
  {%- capture xp_on -%}{% render 'maison-x-t', k: 'ontime' %}{%- endcapture -%}
  {%- capture xp_late -%}{% render 'maison-x-t', k: 'late' %}{%- endcapture -%}
  <div class="m-pdp-xmas das-x-hide-post">
    <span class="m-pdp-xmas__eyebrow">{% if xp_tip %}{% render 'maison-x-t', k: 'card_tip' %}{% else %}{% render 'maison-x-t', k: 'eyebrow' %}{% endif %}</span>
    <p class="m-pdp-xmas__text das-x-ontime-only">{{ xp_on | replace: '[d]', xp_dl }}</p>
    <p class="m-pdp-xmas__text das-x-late-only">{{ xp_late | replace: '[d]', xp_dl }}</p>
  </div>
  <style>
    .m-pdp-xmas { position: relative; padding: 1.8rem 2rem 1.9rem; background: #12302a; text-align: center; }
    .m-pdp-xmas::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 2px; background: linear-gradient(90deg, #8a6a2c, #e4cd8c 50%, #8a6a2c); }
    .m-pdp-xmas__eyebrow { display: block; margin-bottom: .6rem; font: 500 1rem/1 var(--m-sans, inherit); letter-spacing: .26em; text-transform: uppercase; color: #c9a24b; }
    .m-pdp-xmas__text { margin: 0; font: 400 1.8rem/1.35 var(--m-serif, inherit); color: #f7f2ea; }
    @media (max-width: 749px) { .m-pdp-xmas { padding: 1.5rem 1.4rem 1.6rem; } .m-pdp-xmas__text { font-size: 1.6rem; } }
  </style>
  {%- if das_has_sample -%}
    <a class="m-pdp-sample" href="{{ routes.collections_url }}/samplepakket">{% render 'maison-icon', icon: 'gift' %}<span>{% render 'maison-t', k: 'trust_sample' %}</span><span class="m-pdp-sample__go" aria-hidden="true">&rarr;</span></a>
  {%- endif -%}
  <ul class="m-pdp-usp">
    <li>{% render 'maison-icon', icon: 'truck' %}<span>{% render 'maison-t', k: 'trust_ship' %}</span></li>
    <li>{% render 'maison-icon', icon: 'return' %}<span>{% render 'maison-t', k: 'trust_return' %}</span></li>
    <li>{% render 'maison-icon', icon: 'check' %}<span>{% render 'maison-t', k: 'trust_original' %}</span></li>
  </ul>
  {% render 'maison-whatsapp', context: 'pdp' %}
</div>
{% render 'maison-pdp-style' %}
