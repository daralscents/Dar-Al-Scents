<div class="m-pdp-trust">
  {% render 'maison-pdp-buybox' %}
  {%- liquid
    assign das_has_sample = false
    for v in product.variants
      assign vt = v.title | downcase
      if v.available
        if vt contains 'sample' or vt == '3ml' or vt == '3 ml'
          assign das_has_sample = true
        endif
      endif
    endfor
  -%}
  {%- if das_has_sample -%}
    <div class="m-pdp-trust__row">{% render 'maison-icon', icon: 'gift' %}<span><a href="{{ routes.collections_url }}/samplepakket" style="color: inherit; text-underline-offset: .3rem;">{% render 'maison-t', k: 'trust_sample' %}</a></span></div>
  {%- endif -%}
  <div class="m-pdp-trust__row">{% render 'maison-icon', icon: 'return' %}<span>{% render 'maison-t', k: 'trust_return' %}</span></div>
  <div class="m-pdp-trust__row">{% render 'maison-icon', icon: 'check' %}<span>{% render 'maison-t', k: 'trust_original' %}</span></div>
  {% render 'maison-whatsapp', context: 'pdp' %}
</div>