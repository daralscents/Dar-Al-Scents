{%- comment -%}
  Maison PDP alternatieven (31 okt 2026): alleen als geen enkele grote fles van dit product beschikbaar is.
  Toont max. 3 andere geuren met een beschikbare grote fles: eerst van hetzelfde merk, dan uit de overige
  collecties van het product (geen seizoens-/sample-collecties).
{%- endcomment -%}
{%- liquid
  assign alt_bottle = false
  for v in product.variants
    assign vt = v.title | downcase
    unless vt contains 'sample'
      if v.available
        assign alt_bottle = true
      endif
    endunless
  endfor
-%}
{%- unless alt_bottle -%}
  {%- liquid
    assign l = request.locale.iso_code | slice: 0, 2
    case l
      when 'de'
        assign alt_h = 'Diese Flasche ist vorübergehend ausverkauft. Ähnlich und auf Lager:'
      when 'fr'
        assign alt_h = 'Ce flacon est temporairement épuisé. Similaires et en stock :'
      when 'en'
        assign alt_h = 'This bottle is temporarily sold out. Similar and in stock:'
      else
        assign alt_h = 'Deze fles is tijdelijk uitverkocht. Vergelijkbaar en op voorraad:'
    endcase
    assign skip = 'samplepakket,black-friday,cadeaus-onder-30,giftset,all,frontpage'
    assign brand_handle = product.vendor | handleize | append: '-parfum'
    assign picked = ''
    assign n = 0
  -%}
  {%- capture alt_items -%}
    {%- for pass in (1..2) -%}
      {%- for c in product.collections -%}
        {%- if n >= 3 -%}{%- break -%}{%- endif -%}
        {%- liquid
          assign use = false
          if pass == 1 and c.handle == brand_handle
            assign use = true
          elsif pass == 2 and c.handle != brand_handle
            unless skip contains c.handle
              assign use = true
            endunless
          endif
        -%}
        {%- if use -%}
          {%- for p in c.products limit: 50 -%}
            {%- if n >= 3 -%}{%- break -%}{%- endif -%}
            {%- assign key = '|' | append: p.id | append: '|' -%}
            {%- if p.id == product.id or picked contains key -%}{%- continue -%}{%- endif -%}
            {%- assign pv = nil -%}
            {%- for v in p.variants -%}
              {%- assign vt = v.title | downcase -%}
              {%- unless vt contains 'sample' -%}
                {%- if v.available and pv == nil -%}{%- assign pv = v -%}{%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
            {%- if pv -%}
              {%- assign picked = picked | append: key -%}
              {%- assign n = n | plus: 1 -%}
              <a class="m-alt__item" href="{{ p.url }}">
                {%- if p.featured_image -%}
                  {{ p.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: p.title, class: 'm-alt__img', width: 120, height: 120 }}
                {%- endif -%}
                <span class="m-alt__t">{{ p.title | escape }}</span>
                <span class="m-alt__p">{{ pv.price | money }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if n > 0 -%}
    <div class="m-alt">
      <p class="m-alt__h">{{ alt_h }}</p>
      <div class="m-alt__grid">{{ alt_items }}</div>
    </div>
    <style>
      .m-alt { margin: 0 0 2rem; padding: 1.6rem; background: #efe8dc; }
      .m-alt__h { margin: 0 0 1.2rem; font: 500 1.35rem/1.4 var(--m-sans, inherit); color: var(--m-ink, #100f0d); }
      .m-alt__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
      .m-alt__item { display: grid; gap: .5rem; align-content: start; color: inherit; text-decoration: none; }
      .m-alt__img { width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; background: #f7f2ea; }
      .m-alt__t { font: 500 1.35rem/1.25 var(--m-serif, inherit); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .m-alt__p { font-size: 1.25rem; color: rgba(16, 15, 13, .72); }
      .m-alt__item:hover .m-alt__t { text-decoration: underline; text-underline-offset: .3rem; text-decoration-color: var(--m-gold, #9c7d48); }
    </style>
  {%- endif -%}
{%- endunless -%}
