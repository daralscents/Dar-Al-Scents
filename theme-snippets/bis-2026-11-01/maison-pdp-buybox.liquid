{%- comment -%}
  Maison PDP koopblok (31 okt 2026): voorraadmelding + verzendregel direct onder de knop
  en vaste koopbalk onderaan op mobiel. Gerenderd bovenaan maison-pdp-trust.
  Voorraad = echte inventory_quantity van de gekozen variant; volgt variantwissel via Dawn pub/sub.
{%- endcomment -%}
{%- liquid
  assign l = request.locale.iso_code | slice: 0, 2
  case l
    when 'de'
      assign t_in = 'Auf Lager – Versand innerhalb von 1–3 Werktagen'
      assign t_low = 'Nur noch [n] auf Lager – Versand innerhalb von 1–3 Werktagen'
      assign t_out = 'Vorübergehend ausverkauft'
      assign t_buy = 'In den Warenkorb'
      assign t_sold = 'Ausverkauft'
      assign t_bis_h = 'Benachrichtige mich, wenn er wieder da ist'
      assign t_bis_ph = 'Deine E-Mail-Adresse'
      assign t_bis_btn = 'Benachrichtigen'
      assign t_bis_ok = 'Danke! Wir mailen dir, sobald er wieder auf Lager ist.'
      assign t_bis_err = 'Das hat nicht geklappt. Bitte prüfe deine E-Mail-Adresse.'
    when 'fr'
      assign t_in = 'En stock – expédié sous 1 à 3 jours ouvrés'
      assign t_low = 'Plus que [n] en stock – expédié sous 1 à 3 jours ouvrés'
      assign t_out = 'Temporairement épuisé'
      assign t_buy = 'Ajouter au panier'
      assign t_sold = 'Épuisé'
      assign t_bis_h = 'Prévenez-moi quand il est de retour'
      assign t_bis_ph = 'Votre adresse e-mail'
      assign t_bis_btn = 'Me prévenir'
      assign t_bis_ok = 'Merci ! Nous vous écrirons dès son retour en stock.'
      assign t_bis_err = 'Cela n’a pas fonctionné. Vérifiez votre adresse e-mail.'
    when 'en'
      assign t_in = 'In stock – ships within 1–3 business days'
      assign t_low = 'Only [n] left – ships within 1–3 business days'
      assign t_out = 'Temporarily sold out'
      assign t_buy = 'Add to cart'
      assign t_sold = 'Sold out'
      assign t_bis_h = 'Email me when it’s back'
      assign t_bis_ph = 'Your email address'
      assign t_bis_btn = 'Notify me'
      assign t_bis_ok = 'Thanks! We’ll email you as soon as it’s back in stock.'
      assign t_bis_err = 'That didn’t work. Please check your email address.'
    else
      assign t_in = 'Op voorraad – verzonden binnen 1–3 werkdagen'
      assign t_low = 'Nog maar [n] op voorraad – verzonden binnen 1–3 werkdagen'
      assign t_out = 'Tijdelijk uitverkocht'
      assign t_buy = 'In winkelmand'
      assign t_sold = 'Uitverkocht'
      assign t_bis_h = 'Mail mij als hij er weer is'
      assign t_bis_ph = 'Je e-mailadres'
      assign t_bis_btn = 'Houd mij op de hoogte'
      assign t_bis_ok = 'Dank je! We mailen je zodra hij weer op voorraad is.'
      assign t_bis_err = 'Dat lukte niet. Controleer je e-mailadres.'
  endcase
  assign cv = product.selected_or_first_available_variant
-%}
<div class="m-bb" data-m-bb>
  <p class="m-bb__stock" data-m-bb-stock></p>
  <form class="m-bis" data-m-bis hidden novalidate>
    <p class="m-bis__h">{{ t_bis_h }}</p>
    <div class="m-bis__row">
      <label class="visually-hidden" for="m-bis-email-{{ product.id }}">{{ t_bis_ph }}</label>
      <input class="m-bis__in" id="m-bis-email-{{ product.id }}" type="email" name="email" required autocomplete="email" placeholder="{{ t_bis_ph }}">
      <button class="m-bis__btn" type="submit">{{ t_bis_btn }}</button>
    </div>
    <p class="m-bis__msg" data-m-bis-msg role="status"></p>
  </form>
  <p class="m-bb__ship">{% render 'maison-icon', icon: 'truck' %}<span>{% render 'maison-t', k: 'trust_free' %}</span></p>
</div>
<div class="m-sbb" data-m-sbb aria-hidden="true">
  <div class="m-sbb__info">
    <span class="m-sbb__title">{{ product.title | escape }}</span>
    <span class="m-sbb__meta"><span data-m-sbb-variant></span><span data-m-sbb-dot> · </span><span data-m-sbb-price>{{ cv.price | money }}</span></span>
  </div>
  <button type="button" class="m-sbb__btn" data-m-sbb-btn tabindex="-1">{{ t_buy }}</button>
</div>
<script type="application/json" data-m-bb-json>
  {
    "current": {{ cv.id | json }},
    "t": {"in": {{ t_in | json }}, "low": {{ t_low | json }}, "out": {{ t_out | json }}, "buy": {{ t_buy | json }}, "sold": {{ t_sold | json }}, "bok": {{ t_bis_ok | json }}, "berr": {{ t_bis_err | json }}},
    "v": {
      {%- for v in product.variants -%}
        {%- liquid
          assign tracked = true
          if v.inventory_management != 'shopify' or v.inventory_policy == 'continue'
            assign tracked = false
          endif
        -%}
        "{{ v.id }}": {"a": {{ v.available | json }}, "q": {% if tracked %}{{ v.inventory_quantity | default: 0 }}{% else %}null{% endif %}, "p": {{ v.price | money | json }}, "n": {{ v.title | json }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  }
</script>
<style>
  .m-bb { margin: 0 0 1.6rem; display: grid; gap: .8rem; }
  .m-bb__stock { margin: 0; display: flex; align-items: center; gap: .9rem; font: 500 1.35rem/1.4 var(--m-sans, inherit); letter-spacing: .02em; color: var(--m-ink, #100f0d); }
  .m-bb__stock::before { content: ''; flex: none; width: .9rem; height: .9rem; border-radius: 50%; background: #2f8a4c; box-shadow: 0 0 0 .35rem rgba(47, 138, 76, .15); }
  .m-bb__stock.is-low::before { background: #b7791f; box-shadow: 0 0 0 .35rem rgba(183, 121, 31, .15); }
  .m-bb__stock.is-out::before { background: #9a9389; box-shadow: none; }
  .m-bb__stock:empty { display: none; }
  .m-bb__ship { margin: 0; display: flex; align-items: center; gap: .9rem; font-size: 1.3rem; line-height: 1.45; color: rgba(16, 15, 13, .72); }
  .m-bb__ship svg { width: 1.8rem; height: 1.8rem; flex: none; }
  .product-form__input label.m-vo-try { display: inline-flex; flex-direction: column; align-items: center; gap: .2rem; line-height: 1.15; padding-top: .7rem; padding-bottom: .7rem; }
  .m-vo-try__k { font-size: 1rem; letter-spacing: .14em; text-transform: uppercase; color: var(--m-gold, #9c7d48); }
  .product-form__input input[type='radio']:checked + label.m-vo-try .m-vo-try__k { color: inherit; opacity: .8; }
  .product-form__input input[type='radio'].disabled + label.m-vo-try,
  .product-form__input input[type='radio']:disabled + label.m-vo-try { text-decoration: none; opacity: .55; }
  .m-bis { margin: .4rem 0 .4rem; padding: 1.4rem 1.6rem; background: #efe8dc; }
  .m-bis[hidden] { display: none; }
  .m-bis__h { margin: 0 0 1rem; font: 500 1.35rem/1.4 var(--m-sans, inherit); color: var(--m-ink, #100f0d); }
  .m-bis__row { display: flex; gap: .8rem; }
  .m-bis__in { flex: 1; min-width: 0; height: 4.4rem; padding: 0 1.2rem; border: 1px solid rgba(16, 15, 13, .25); background: #fff; font-size: 1.4rem; border-radius: 0; }
  .m-bis__btn { flex: none; height: 4.4rem; padding: 0 1.6rem; border: 0; background: var(--m-ink, #100f0d); color: var(--m-ivory, #f7f2ea); font: 500 1.1rem/1 var(--m-sans, inherit); letter-spacing: .12em; text-transform: uppercase; cursor: pointer; }
  .m-bis__btn[disabled] { opacity: .5; }
  .m-bis__msg { margin: .8rem 0 0; font-size: 1.25rem; color: rgba(16, 15, 13, .75); }
  .m-bis__msg:empty { display: none; }
  @media (max-width: 420px) { .m-bis__row { flex-direction: column; } .m-bis__btn { width: 100%; } }
  .m-sbb { display: none; }
  @media (max-width: 749px) {
    .m-sbb { display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 39; align-items: center; gap: 1.2rem; padding: 1rem 1.6rem calc(1rem + env(safe-area-inset-bottom)); background: var(--m-ivory, #f7f2ea); border-top: 1px solid rgba(156, 125, 72, .45); box-shadow: 0 -10px 28px -18px rgba(16, 15, 13, .45); transform: translateY(110%); transition: transform .3s ease; }
    .m-sbb.is-on { transform: none; }
    .m-sbb__info { min-width: 0; flex: 1; display: grid; gap: .2rem; }
    .m-sbb__title { font: 500 1.5rem/1.2 var(--m-serif, inherit); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .m-sbb__meta { font-size: 1.2rem; color: rgba(16, 15, 13, .7); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .m-sbb__btn { flex: none; height: 4.4rem; padding: 0 1.8rem; border: 0; border-radius: 0; background: var(--m-ink, #100f0d); color: var(--m-ivory, #f7f2ea); font: 500 1.15rem/1 var(--m-sans, inherit); letter-spacing: .14em; text-transform: uppercase; cursor: pointer; }
    .m-sbb__btn[disabled] { opacity: .45; cursor: default; }
    body.m-sbb-on .m-wa { bottom: calc(7.6rem + env(safe-area-inset-bottom)); }
  }
</style>
<script>
  (function () {
    if (!document.currentScript) return;
    var root = document.currentScript.parentNode;
    var sec = root.closest('.shopify-section') || document;
    var inModal = !!root.closest('quick-add-modal, .quick-add-modal');
    function init() {
    var dataEl = root.querySelector('[data-m-bb-json]');
    if (!dataEl || root.dataset.mBbInit) return;
    root.dataset.mBbInit = '1';
    var d = JSON.parse(dataEl.textContent);
    var stock = root.querySelector('[data-m-bb-stock]');
    var bar = root.querySelector('[data-m-sbb]');
    var barBtn = root.querySelector('[data-m-sbb-btn]');
    var barPrice = root.querySelector('[data-m-sbb-price]');
    var barVar = root.querySelector('[data-m-sbb-variant]');
    var barDot = root.querySelector('[data-m-sbb-dot]');
    var bis = root.querySelector('[data-m-bis]');
    var bisMsg = root.querySelector('[data-m-bis-msg]');
    var curId = d.current;
    function render(id) {
      var v = d.v[String(id)];
      if (!v) return;
      stock.classList.remove('is-low', 'is-out');
      if (!v.a) { stock.textContent = d.t.out; stock.classList.add('is-out'); }
      else if (v.q !== null && v.q > 0 && v.q <= 5) { stock.textContent = d.t.low.replace('[n]', v.q); stock.classList.add('is-low'); }
      else { stock.textContent = d.t.in; }
      barPrice.textContent = v.p;
      var dflt = v.n === 'Default Title';
      barVar.textContent = dflt ? '' : v.n;
      barDot.hidden = dflt;
      barBtn.disabled = !v.a;
      barBtn.textContent = v.a ? d.t.buy : d.t.sold;
      curId = id;
      if (bis) { bis.hidden = !!v.a; bisMsg.textContent = ''; }
    }
    if (bis) bis.addEventListener('submit', function (ev) {
      ev.preventDefault();
      var email = bis.email.value.trim();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { bisMsg.textContent = d.t.berr; return; }
      var btn = bis.querySelector('button'); btn.disabled = true;
      fetch('https://a.klaviyo.com/client/back-in-stock-subscriptions/?company_id=Vb5njv', {
        method: 'POST',
        headers: { 'Content-Type': 'application/vnd.api+json', 'revision': '2024-10-15' },
        body: JSON.stringify({ data: { type: 'back-in-stock-subscription', attributes: { channels: ['EMAIL'], profile: { data: { type: 'profile', attributes: { email: email } } } }, relationships: { variant: { data: { type: 'catalog-variant', id: '$shopify:::$default:::' + curId } } } } })
      }).then(function (r) {
        if (r.ok) { bisMsg.textContent = d.t.bok; bis.email.value = ''; } else { bisMsg.textContent = d.t.berr; btn.disabled = false; }
      }).catch(function () { bisMsg.textContent = d.t.berr; btn.disabled = false; });
    });
    render(d.current);
    if (inModal) { bar.remove(); return; }
    if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined' && PUB_SUB_EVENTS.variantChange) {
      subscribe(PUB_SUB_EVENTS.variantChange, function (e) { if (e && e.data && e.data.variant) render(e.data.variant.id); });
    } else {
      document.addEventListener('change', function () {
        setTimeout(function () { var i = sec.querySelector('product-form input[name="id"]'); if (i) render(i.value); }, 400);
      });
    }
    function mainBtn() { return sec.querySelector('.product-form__submit[name="add"]'); }
    barBtn.addEventListener('click', function () {
      var b = mainBtn();
      if (!b) return;
      if (!b.disabled) b.click();
      else b.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
    var b = mainBtn();
    if (b && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (en) {
        var off = !en[0].isIntersecting && en[0].boundingClientRect.top < 0;
        bar.classList.toggle('is-on', off);
        bar.setAttribute('aria-hidden', off ? 'false' : 'true');
        barBtn.tabIndex = off ? 0 : -1;
        document.body.classList.toggle('m-sbb-on', off);
      }).observe(b);
    }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
</script>
