{%- comment -%}
  Maison – Bezorggarantie (optioneel, v14, 13 okt 2026).
  Vinkje in de winkelmand dat het product "bezorggarantie" (€1,95, geen verzending) toevoegt of verwijdert.
  Dekt extra NA bezorging (gemeld als bezorgd maar niet ontvangen / gestolen na bezorging): vervanging binnen 24 uur.
  Verlies en schade onderweg zijn altijd gratis gedekt (wettelijk). Voorwaarden: /pages/bezorggarantie.
{%- endcomment -%}
{%- liquid
  assign bg_product = all_products['bezorggarantie']
  assign bg_variant = bg_product.selected_or_first_available_variant
  assign bg_line = nil
  assign bg_other = 0
  for item in cart.items
    if item.product.handle == 'bezorggarantie'
      assign bg_line = item
    else
      assign bg_other = bg_other | plus: item.quantity
    endif
  endfor
  case request.locale.iso_code
    when 'de'
      assign bg_title = 'Zustellgarantie'
      assign bg_text = 'Als zugestellt gemeldet, aber nicht erhalten oder nach der Zustellung gestohlen? Wir senden innerhalb von 24 Stunden einen Ersatz. Verlust oder Schaden unterwegs ist immer kostenlos abgedeckt.'
      assign bg_link = 'Bedingungen'
    when 'fr'
      assign bg_title = 'Garantie de livraison'
      assign bg_text = 'Colis indiqué comme livré mais non reçu, ou volé après la livraison ? Nous envoyons un remplacement sous 24 heures. La perte ou les dommages pendant le transport sont toujours couverts gratuitement.'
      assign bg_link = 'Conditions'
    when 'en'
      assign bg_title = 'Delivery guarantee'
      assign bg_text = 'Marked as delivered but not received, or stolen after delivery? We send a replacement within 24 hours. Loss or damage in transit is always covered free of charge.'
      assign bg_link = 'Terms'
    else
      assign bg_title = 'Bezorggarantie'
      assign bg_text = 'Staat je pakket als bezorgd maar heb je het niet, of is het na bezorging gestolen? Dan sturen we binnen 24 uur een nieuw exemplaar. Verlies of schade onderweg is altijd gratis gedekt.'
      assign bg_link = 'Voorwaarden'
  endcase
-%}
{%- if bg_variant and bg_other > 0 or bg_line -%}
  <maison-bezorggarantie class="m-bg" data-variant="{{ bg_variant.id }}" data-line="{% if bg_line %}{{ bg_line.key }}{% endif %}" data-other="{{ bg_other }}">
    <label class="m-bg__label">
      <input type="checkbox" class="m-bg__check"{% if bg_line %} checked{% endif %}>
      <span class="m-bg__body">
        <span class="m-bg__title">{{ bg_title }} <span class="m-bg__price">+{{ bg_variant.price | money }}</span></span>
        <span class="m-bg__text">{{ bg_text }} <a href="{{ routes.root_url | append: '/pages/bezorggarantie' | replace: '//', '/' }}" class="m-bg__more">{{ bg_link }}</a></span>
      </span>
    </label>
  </maison-bezorggarantie>
  <style>
    .m-bg { display: block; margin: 0 0 1.2rem; padding: 1.2rem 1.4rem; border: 1px solid rgba(156, 125, 72, .45); background: #fbf8f1; }
    .m-bg__label { display: flex; gap: 1.2rem; align-items: flex-start; cursor: pointer; }
    .m-bg__check { flex: none; width: 1.8rem; height: 1.8rem; margin: .2rem 0 0; accent-color: #100f0d; cursor: pointer; }
    .m-bg__body { display: grid; gap: .4rem; }
    .m-bg__title { font: 500 1.35rem/1.3 var(--m-sans, inherit); color: #100f0d; }
    .m-bg__price { color: #9c7d48; font-weight: 500; }
    .m-bg__text { font-size: 1.2rem; line-height: 1.5; color: rgba(16, 15, 13, .7); }
    .m-bg__more { color: inherit; text-decoration: underline; text-underline-offset: .2rem; }
    .m-bg.is-busy { opacity: .6; pointer-events: none; }
  </style>
  <script>
    if (!customElements.get('maison-bezorggarantie')) {
      customElements.define('maison-bezorggarantie', class extends HTMLElement {
        connectedCallback() {
          this.box = this.querySelector('.m-bg__check');
          if (!this.box) return;
          this.box.addEventListener('change', () => this.toggle(this.box.checked));
          if (this.dataset.line && Number(this.dataset.other) === 0) this.toggle(false);
        }
        async toggle(on) {
          this.classList.add('is-busy');
          const sections = 'cart-drawer,cart-icon-bubble';
          let url, body;
          if (on) {
            url = (window.routes && window.routes.cart_add_url ? window.routes.cart_add_url : '/cart/add') + '.js';
            body = { items: [{ id: Number(this.dataset.variant), quantity: 1 }], sections, sections_url: window.location.pathname };
          } else {
            url = (window.routes && window.routes.cart_change_url ? window.routes.cart_change_url : '/cart/change') + '.js';
            body = { id: this.dataset.line, quantity: 0, sections, sections_url: window.location.pathname };
          }
          try {
            const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) });
            const data = await res.json();
            if (!res.ok || data.status) throw new Error('cart');
            const drawer = document.querySelector('cart-drawer');
            if (drawer && data.sections && typeof drawer.renderContents === 'function') {
              drawer.renderContents(data);
            } else {
              window.location.reload();
            }
          } catch (e) {
            this.classList.remove('is-busy');
            this.box.checked = !on;
          }
        }
      });
    }
  </script>
{%- endif -%}
