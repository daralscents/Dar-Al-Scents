{%- comment -%}
  Kerststrook onder de menubalk (alle pagina's behalve homepage en collectiepagina's): besteldeadline + aftelklok, link naar giftsets.
  Fases via maison-x-head. Verdwijnt na 26 dec.
{%- endcomment -%}
{%- unless template.name == 'index' or template.name == 'collection' -%}
{%- capture xs_dl -%}{% render 'maison-x-t', k: 'deadline' %}{%- endcapture -%}
{%- capture xs_on -%}{% render 'maison-x-t', k: 'ontime' %}{%- endcapture -%}
{%- capture xs_late -%}{% render 'maison-x-t', k: 'late' %}{%- endcapture -%}
<a class="m-xs das-x-hide-post" href="{{ routes.collections_url }}/giftset" data-x-countdown>
  <span class="m-xs__tag">{% render 'maison-x-t', k: 'eyebrow' %}</span>
  <span class="m-xs__txt das-x-ontime-only">{{ xs_on | replace: '[d]', xs_dl }}</span>
  <span class="m-xs__cd das-x-ontime-only"><b data-x-d>0</b> {% render 'maison-x-t', k: 'd' %} <b data-x-h>00</b> {% render 'maison-x-t', k: 'h' %} <b data-x-m>00</b> {% render 'maison-x-t', k: 'm' %}</span>
  <span class="m-xs__txt das-x-late-only">{{ xs_late | replace: '[d]', xs_dl }}</span>
  <span class="m-xs__go">{% render 'maison-x-t', k: 'guide' %} &rarr;</span>
</a>
<style>
  .m-xs { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: .6rem 1.6rem; padding: 1rem 1.6rem; background: #12302a; color: #e4cd8c; text-decoration: none; font: 500 1.2rem/1.3 var(--m-sans, inherit); letter-spacing: .06em; border-bottom: 1px solid rgba(201, 162, 75, .4); }
  .m-xs__tag { padding: .4rem .8rem; border: 1px solid #c9a24b; color: #e4cd8c; letter-spacing: .18em; text-transform: uppercase; font-size: 1.05rem; }
  .m-xs__txt { color: #f7f2ea; }
  .m-xs__cd { font-variant-numeric: tabular-nums; }
  .m-xs__cd b { font-weight: 600; color: #f7f2ea; }
  .m-xs__go { text-transform: uppercase; letter-spacing: .18em; font-size: 1.05rem; text-decoration: underline; text-underline-offset: .3rem; }
  .m-xs:hover .m-xs__go { color: #f7f2ea; }
  @media (max-width: 749px) { .m-xs { gap: .4rem 1rem; font-size: 1.1rem; } .m-xs__go, .m-xs__tag { display: none; } }
</style>
{%- endunless -%}

{% schema %}
{
  "name": "Kerst – strook",
  "tag": "div",
  "settings": []
}
{% endschema %}
