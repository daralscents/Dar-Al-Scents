{%- comment -%}
  Maison – Kerst 2026, sitebrede laag (in header-group).
  Zet <html> op das-x-ontime (vóór besteldeadline) / das-x-late (deadline voorbij, t/m 26 dec) / das-x-post (daarna),
  op basis van de echte tijd van de bezoeker. Telt af naar de deadline in [data-x-countdown].
  DEADLINE = 18 dec 23:59 NL-tijd (ook tekst in maison-x-t, sleutel 'deadline'). Kerstkleuren voor de aankondigingsbalk.
{%- endcomment -%}
<style>
  :root { --x-green: #12302a; --x-green-2: #1c4238; --x-gold: #c9a24b; --x-gold-soft: #e4cd8c; --x-ivory: #f7f2ea; }
  html:not(.das-x-ontime) .das-x-ontime-only,
  html:not(.das-x-late) .das-x-late-only,
  html:not(.das-x-post) .das-x-post-only,
  html.das-x-post .das-x-hide-post { display: none !important; }
  .announcement-bar-section .utility-bar,
  .announcement-bar-section .announcement-bar { background: var(--x-green) !important; color: var(--x-gold-soft) !important; }
  .announcement-bar-section .announcement-bar__message,
  .announcement-bar-section .announcement-bar__link,
  .announcement-bar-section .announcement-bar__message span { color: var(--x-gold-soft) !important; letter-spacing: .12em; }
  .announcement-bar-section .slider-button { color: var(--x-gold-soft) !important; }
  .m-pdp-trust__row--x { color: var(--x-green); font-weight: 500; }
  .m-pdp-trust__row--x svg { color: var(--x-gold); }
  /* ===== Sitebrede kerststijl (21 okt): header, collecties, kaarten, footer, winkelmand ===== */
  .header-wrapper { border-bottom: 2px solid var(--x-gold) !important; }
  .header__menu-item:hover span { text-decoration-color: var(--x-gold) !important; }
  .collection-hero { --color-background: 18,48,42; --gradient-background: #12302a; --color-foreground: 236,228,212; position: relative; background: #12302a !important; color: #ece4d4 !important; }
  .collection-hero::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: linear-gradient(90deg, #8a6a2c, #e4cd8c 50%, #8a6a2c); }
  .collection-hero__title { color: #f7f2ea !important; }
  .collection-hero__description, .collection-hero__description p { color: #c5cbbf !important; }
  .collection-hero .m-trust, .collection-hero .m-trust a, .collection-hero .m-desc__more { color: #e4cd8c !important; }
  .card-wrapper .card__inner { transition: box-shadow .4s ease; }
  .card-wrapper:hover .card__inner { box-shadow: inset 0 0 0 1px var(--x-gold); }
  .footer { --color-background: 18,48,42; --gradient-background: #12302a; background: #12302a !important; border-top: 3px solid var(--x-gold) !important; }
  cart-drawer .drawer__header { border-bottom: 2px solid var(--x-gold); }
  /* Homepage: gouden scheidingslijn tussen secties, groene accenten */
  .m-section + .m-section { box-shadow: inset 0 1px 0 rgba(201, 162, 75, .35); }
  .m-section .m-h2 em, .m-display em { color: #1c4238; }
  .m-section .m-eyebrow { color: #9c7d48; }
  .m-section--ink { background: #12302a !important; }
  .m-section .m-btn:not(.m-x .m-btn) { background: #12302a; border-color: #12302a; color: #f7f2ea; }
  .m-section .m-btn:not(.m-x .m-btn):hover { background: transparent; color: #12302a; }
  .m-section--ink .m-btn { background: #e4cd8c !important; border-color: #e4cd8c !important; color: #12302a !important; }
  .m-marquee { background: #12302a; }
  /* Collectiebanner rustig (22 okt): gecentreerd, beschrijving max. 2 regels + Lees meer, één stille regel vertrouwen */
  .collection-hero__inner { justify-content: center; }
  .collection-hero__text-wrapper { max-width: 68rem; margin-inline: auto; padding-block: 1.2rem .8rem; text-align: center; }
  .collection-hero__title { margin: 0 0 1.4rem; font-weight: 400; letter-spacing: -.01em; }
  .collection-hero .m-desc { max-width: 60rem; margin-inline: auto; font-size: 1.45rem; line-height: 1.65; }
  .collection-hero .m-desc:not(.is-open) { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .collection-hero .m-desc > * { margin-block: 0 .6rem; }
  .collection-hero .m-desc__more:not([hidden]) { display: inline-block; margin: .8rem auto 0; font-size: .95rem; }
  .collection-hero .m-trust { justify-content: center; flex-wrap: wrap !important; overflow: visible !important; gap: .4rem 0 !important; margin-top: 2rem; padding: 1.4rem 0 0 !important; border-top: 1px solid rgba(201, 162, 75, .28); font-size: .95rem !important; letter-spacing: .18em; }
  .collection-hero .m-trust li { padding: 0 1.6rem; white-space: nowrap; }
  .collection-hero .m-trust li::before { display: none; }
  .collection-hero .m-trust li + li { border-left: 1px solid rgba(201, 162, 75, .35); }
  .collection-hero .m-trust li:has(.m-trust__link) { display: none; }
  @media (max-width: 749px) {
    .collection-hero__text-wrapper { padding-block: .4rem 0; }
    .collection-hero .m-desc { font-size: 1.35rem; }
    .collection-hero .m-trust li { padding: .2rem 1rem; font-size: .85rem; }
    .collection-hero .m-trust li:nth-child(3) { border-left: 0; }
  }
  .m-card-note--tip { color: #1c4238 !important; font-weight: 500; }
</style>
<script>
  (function () {
    var D = Date.parse('2026-12-18T23:59:59+01:00');
    var P = Date.parse('2026-12-26T23:59:59+01:00');
    var root = document.documentElement;
    function phase() { var n = Date.now(); return n <= D ? 'ontime' : (n <= P ? 'late' : 'post'); }
    function pad(x) { return (x < 10 ? '0' : '') + x; }
    function tick() {
      var p = phase();
      root.classList.remove('das-x-ontime', 'das-x-late', 'das-x-post');
      root.classList.add('das-x-' + p);
      var diff = Math.max(0, D - Date.now());
      var d = Math.floor(diff / 864e5), h = Math.floor(diff / 36e5) % 24, m = Math.floor(diff / 6e4) % 60;
      document.querySelectorAll('[data-x-countdown]').forEach(function (el) {
        var set = function (k, v) { var t = el.querySelector('[data-x-' + k + ']'); if (t) t.textContent = v; };
        set('d', d); set('h', pad(h)); set('m', pad(m));
      });
    }
    tick();
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', tick);
    setInterval(tick, 30000);
  })();
</script>

